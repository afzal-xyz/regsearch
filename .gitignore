# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.egg

# uv / virtualenv
.venv/
venv/

# Environments & secrets
.env
.env.*

# Testing / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw eCFR data — never commit
data/raw/*
!data/raw/.gitkeep

# Derived chunk output
data/chunks/*
!data/chunks/.gitkeep

# Built index (SQLite db + vectors + BM25)
data/index/*
!data/index/.gitkeep

# Eval run outputs (gold.jsonl IS tracked; results are not)
eval/results/*
!eval/results/.gitkeep

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
model_*.txt
